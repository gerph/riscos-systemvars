#ifndef VARIABLES_H
#define VARIABLES_H

#include <stdbool.h>
#include <stdint.h>

#include "csstring.h"

typedef struct sysvarvalue_s {
    uint8_t     *data;
    uint32_t     datalen;
} sysvarvalue_t;

typedef enum sysvartype_e {
    svt_string = 0,
    svt_natural = 0,
    svt_number = 1,
    svt_macro = 2,
    svt_expanded = 3,
    svt_literal = 4
#ifndef NO_CODE_VARS
    ,
    svt_code = 16
#endif
} sysvartype_t;

typedef struct sysvar_s sysvar_t;
struct sysvar_s {
    sysvar_t        *next;
    char            *name;
    sysvarvalue_t    value;
    sysvartype_t     type;
};


typedef uint32_t sysvarerror_t;

#define SVE_OK          (0)
#define SVE_NOMEMORY    (1)
#define SVE_BADNAME     (2)
#define SVE_BADLENGTH   (3)
#define SVE_BADPOINTER  (4)
#define SVE_BADTYPE     (5)
#define SVE_LAST        (6)

#define SVE_IS_OSERROR(sve) ((sve > SVE_LAST) ? true : false)
#define SVE_TO_OSERROR(sve) (_kernel_oserror *)(sve)
#define SVE_FROM_OSERROR(err) (sysvarerror_t)(err)


/*************************************************** Gerph *********
 Function:      sysvar_matchname
 Description:   Perform a comparison on the names supplied
 Parameters:    cs1-> first cs string
                cs2-> second cs string
 Returns:       0 if matches
                -ve if cs1 is < cs2
                +ve if cs1 is > cs2
 ******************************************************************/
int sysvar_matchname(csstring_t cs1, csstring_t cs2);


/*************************************************** Gerph *********
 Function:      sysvar_create
 Description:   Create a new system variable
 Parameters:    var-> variable name (ctrlspc-terminated)
                data-> value of the variable
                datalen = the length of the variable
                type = type of the variable
 Returns:       error code
 ******************************************************************/
sysvarerror_t sysvar_create(csstring_t   cs,
                            uint8_t     *data,
                            uint32_t     datalen,
                            sysvartype_t type);


/*************************************************** Gerph *********
 Function:      sysvar_read
 Description:   Retrieve a system variable by name, which might be wildcarded
 Parameters:    var-> variable name (ctrlspc-terminated, may be wildcard)
                context-> last variable name returned, or NULL to start enumeration
 Returns:       pointer to the variable, or NULL if not found
 ******************************************************************/
sysvar_t *sysvar_read(csstring_t   cs,
                      char        *context);


/*************************************************** Gerph *********
 Function:      sysvar_update_or_create
 Description:   Update an existing system variable, or create if doesn't exist
 Parameters:    cs-> variable name (ctrlspc-terminated)
                data-> value of the variable
                datalen = the length of the variable
                type = type of the variable
                context-> where to store the last variable name returned,
                          and where to start searching, or NULL to start at
                          the beginning
 Returns:       error code
 ******************************************************************/
sysvarerror_t sysvar_update_or_create(csstring_t   cs,
                                      uint8_t     *data,
                                      uint32_t     datalen,
                                      sysvartype_t type,
                                      char       **contextp);

/*************************************************** Gerph *********
 Function:      sysvar_delete
 Description:   Delete a system variable by name, which might be wildcarded
 Parameters:    var-> variable name (ctrlspc-terminated, may be wildcard)
 Returns:       true if we deleted anything; false if we did not
 ******************************************************************/
bool sysvar_delete(csstring_t cs);

/*************************************************** Gerph *********
 Function:      sysvar_final
 Description:   Finalise the System Variables and release all memory
 Parameters:    none
 Returns:       none
 ******************************************************************/
void sysvar_final(void);

/*************************************************** Gerph *********
 Function:      sysvars_dump
 Description:   Produce a list of all the system variables that we know
 Parameters:    none
 Returns:       none
 ******************************************************************/
void sysvars_dump(void);


#endif
