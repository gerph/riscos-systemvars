#include <stdint.h>
#include <stdlib.h>

#include "kernel.h"
#include "riscos/NewErrors.h"

#include "fortify.h"

#include "os.h"
#include "modhead.h"

#define BUFFER_INITIAL      (16)
#define BUFFER_EXTENSION    (16)

/* FIXME: Reentrancy will cause issues here */
int gstrans_buflen = 0;
char *gstrans_buffer = NULL;

/*************************************************** Gerph *********
 Function:      gstrans_translate
 Description:   Perform a translation through GSTrans, allocating into a buffer
 Parameters:    flags = the GSTrans flags (see os.h)
                data-> the input string to GSTrans
                outputp-> where store the newly allocated buffer
                outputlenp = where the length of the data will be stored
                bytesreadp-> where the length read will be stored.
 Returns:       pointer to an error, or NULL if successful
 ******************************************************************/
_kernel_oserror *gstrans_translate(uint32_t flags, const char *data,
                                   char **outputp, uint32_t *outputlenp)
{
    int wrote;
    if (gstrans_buffer == NULL)
    {
        gstrans_buflen = BUFFER_INITIAL;
        gstrans_buffer = malloc(gstrans_buflen);
        if (gstrans_buffer == NULL)
            return err_NoMemory;
    }
    while (1)
    {
        _kernel_oserror *err;
        err = os_gstrans(0, (const char *)data, gstrans_buffer, gstrans_buflen, &wrote);
        if (err)
        {
            if (err->errnum == ErrorNumber_BuffOverflow)
            {
                /* Need to extend the buffer and try again */
                int newbuflen = gstrans_buflen + BUFFER_EXTENSION;
                char *newbuf = realloc(gstrans_buffer, newbuflen);
                if (newbuf == NULL)
                {
                    /* Ran out of memory; fatal */
                    return err_NoMemory;
                }
                gstrans_buffer = newbuf;
                gstrans_buflen = newbuflen;
            }
            else
            {
                /* Error in GSTrans, so we give up */
                return err;
            }
        }
        else
        {
            /* No error - we got our string */
            break;
        }
    }

    *outputp = gstrans_buffer;
    *outputlenp = wrote;
    return NULL;
}


/*************************************************** Gerph *********
 Function:      gstrans_final
 Description:   Finalise the GSTrans system, freeing all memory
 Parameters:    none
 Returns:       none
 ******************************************************************/
void gstrans_final(void)
{
    free(gstrans_buffer);
    gstrans_buffer = NULL;
}
