/* List of all the variables - in alphabetical order */
sysvar_t *sysvars;

/*************************************************** Gerph *********
 Function:      sysvar_matchname
 Description:   Perform a comparison on the names supplied
 Parameters:    cs1-> first cs string
                cs2-> second cs string
 Returns:       0 if matches
                -ve if cs1 is < cs2
                +ve if cs1 is > cs2
 ******************************************************************/
int sysvar_matchname(csstring_t cs1, csstring_t cs2)
{
    while (*cs1 > ' ' || *cs2 > ' ')
    {
        char c1 = *cs1++;
        char c2 = *cs2++;
        if (c1==c2)
            continue;

        /* FIXME: Maybe make this use the locale to be correct */
        if (c1>='A' && c1<='Z')
            c1 |= 32; /* Case insensitive ascii */
        if (c2>='A' && c2<='Z')
            c2 |= 32; /* Case insensitive ascii */
        if (c1 != c2)
            return c1 - c2;
    }
    return 0;
}



/*************************************************** Gerph *********
 Function:      sysvar_create
 Description:   Create a new system variable
 Parameters:    cs-> variable name (ctrlspc-terminated)
                data-> value of the variable
                datalen = the length of the variable
                type = type of the variable
                codepw = private word for code variables
 Returns:       error code
 ******************************************************************/
sysvarerror_t sysvar_create(csstring_t   cs,
                            uint8_t     *data,
                            uint32_t     datalen,
                            sysvartype_t type,
                            void        *codepw)
{
    sysvar_t *sysvar;
    uint8_t *newdata;


    /* FIXME: Check the variable name */
    /* FIXME: Check value memory exists? */
    /* FIXME: Check value length - do we want to restrict the length? */
    /* FIXME: Check the type is acceptable */

    sysvar = malloc(sizeof(*sysvar));
    if (sysvar==NULL)
        goto no_memory_0;

    sysvar->name = csstrdup(cs);
    if (sysvar->name == NULL)
        goto no_memory_1;

    newdata = malloc(datalen + 1);
    if (newdata == NULL)
        goto no_memory_2;

    dprintf("Creating variable %s of length %u\n", cs, datalen);
    memcpy(newdata, data, datalen);
    newdata[datalen] = '\0';

    sysvar->value.data = newdata;
    sysvar->value.datalen = datalen;
    sysvar->type = type;
    sysvar->codepw = codepw;

#ifndef NO_CODE_VARS
    if (type == svt_code)
    {
        /* We need to issue SynchroniseCodeAreas */
        os_synchronisecodeareas((_addr_t)newdata, (_addr_t)(newdata + datalen));
    }
#endif

    /* Link to the list */
    {
        sysvar_t *last = NULL;
        sysvar_t *cur;
        for (cur=sysvars; cur; last=cur, cur=cur->next)
        {
            int match = sysvar_matchname(cur->name, cs);
            if (match == 0)
            {
                /* The variable already exists - we should be updating */
                /* FIXME: Decide how to handle this */
                break;
            }
            if (match > 0)
            {
                /* We have found the insertion point - exit */
                break;
            }
        }

        /* last -> the last entry (or NULL); cur -> the next entry */
        sysvar->next = cur;
        if (last == NULL)
            sysvars = sysvar; /* This was the head of the list */
        else
            last->next = sysvar;
    }

    return SVE_OK;


no_memory_2:
    free(sysvar->name);
no_memory_1:
    free(sysvar);
no_memory_0:
    return SVE_NOMEMORY;
}


/*************************************************** Gerph *********
 Function:      sysvars_free
 Description:   Free the system variable supplied (which has already been unlinked)
 Parameters:    cur-> the variable to free
 Returns:       none
 ******************************************************************/
void sysvars_free(sysvar_t *cur)
{
    free(cur->name);
    free(cur->value.data);
    free(cur);
}


/*************************************************** Gerph *********
 Function:      sysvar_read
 Description:   Retrieve a system variable by name, which might be wildcarded
 Parameters:    var-> variable name (ctrlspc-terminated, may be wildcard)
                context-> last variable name returned, or NULL to start enumeration
 Returns:       pointer to the variable, or NULL if not found
 ******************************************************************/
sysvar_t *sysvar_read(csstring_t   cs,
                      char        *context)
{
    sysvar_t *cur;
    bool wildcarded = cswildcarded(cs);
    if (wildcarded)
    {
        for (cur=sysvars; cur; cur=cur->next)
        {
            if (context != NULL)
            {
                int found = sysvar_matchname(cur->name, context);
                dprintf("Enumeration check: want=%s, current=%s, comparison=%i\n", context, cur->name, found);
                if (found == 0)
                {
                    /* This was the variable they had last, so skip it and return the next */
                    context = NULL;
                    dprintf("  matched, next item will be returned\n");
                    continue;
                }
                if (found < 0)
                {
                    /* We haven't reached the last value yet, so continue searching */
                    dprintf("  too early, continuing\n");
                    continue;
                }
                /* We are beyond the name they supplied, so return this variable */
            }

            {
                int match = wildmatch_sysvars(cs, cur->name);
                dprintf("Checking %s against %s gave %i\n", cur->name, cs, match);
                if (match == 1)
                    return cur;
            }
        }
    }
    else
    {
        if (context != NULL)
            return NULL; /* They wanted to start somewhere - so this is not the first call, and we must stop immediately */

        dprintf("Non-wildcarded search for %s\n", cs);

        for (cur=sysvars; cur; cur=cur->next)
        {
            int match = sysvar_matchname(cur->name, cs);
            dprintf("Checking %s against %s gave %i\n", cur->name, cs, match);
            if (match == 0)
                return cur;
        }
    }
    return NULL;
}


/*************************************************** Gerph *********
 Function:      sysvar_delete
 Description:   Delete a system variable by name, which might be wildcarded
 Parameters:    var-> variable name (ctrlspc-terminated, may be wildcard)
 Returns:       true if we deleted anything; false if we did not
 ******************************************************************/
bool sysvar_delete(csstring_t cs)
{
    sysvar_t *lastvar = NULL;
    sysvar_t *cur;
    sysvar_t *nextvar;
    bool deleted = false;
    bool wildcarded = cswildcarded(cs);
    if (wildcarded)
    {
        for (cur=sysvars; cur; cur=nextvar)
        {
            int match = wildmatch_sysvars(cs, cur->name);
            nextvar = cur->next;
            dprintf("Checking %s against %s gave %i\n", cur->name, cs, match);
            if (match == 1)
            {
                /* Matched, so we can delete this variable */
                if (lastvar == NULL)
                    sysvars = nextvar;
                else
                    lastvar->next = nextvar;
                sysvars_free(cur);
                nextvar = lastvar;
                deleted = true;
            }
            else
            {
                lastvar = cur;
            }
        }
    }
    else
    {
        dprintf("Non-wildcarded search for %s\n", cs);

        for (cur=sysvars; cur; cur=nextvar)
        {
            int match = sysvar_matchname(cur->name, cs);
            nextvar = cur->next;
            dprintf("Checking %s against %s gave %i\n", cur->name, cs, match);
            if (match == 0)
            {
                /* Matched, so we can delete this variable */
                if (lastvar == NULL)
                    sysvars = cur->next;
                else
                    lastvar->next = cur->next;
                sysvars_free(cur);
                nextvar = lastvar;
                deleted = true;
                continue;
            }
            else
            {
                lastvar = cur;
            }
        }
    }
    return deleted;
}



/*************************************************** Gerph *********
 Function:      sysvar_update_or_create
 Description:   Update an existing system variable, or create if doesn't exist
 Parameters:    cs-> variable name (ctrlspc-terminated)
                data-> value of the variable
                datalen = the length of the variable
                type = type of the variable
                codepw = the private word for code variables
                context-> where to store the last variable name returned,
                          and where to start searching, or NULL to start at
                          the beginning
 Returns:       error code
 ******************************************************************/
sysvarerror_t sysvar_update_or_create(csstring_t   cs,
                                      uint8_t     *data,
                                      uint32_t     datalen,
                                      sysvartype_t type,
                                      void        *codepw,
                                      char       **contextp)
{
    char *context = *contextp;
    sysvar_t *sysvar;

    if (datalen > 0 && data < (uint8_t *)0x8000)
        return SVE_BADPOINTER;

    sysvar = sysvar_read(cs, context);
    if (sysvar == NULL)
    {
        /* Not found, so this is a new variable */
        *contextp = NULL;
        return sysvar_create(cs, data, datalen, type, codepw);
    }
    /* We are updating a variable */

    /* FIXME: We should apply value length checks like in create */

    /* If the variable type has changed, we need to be careful */
    if (sysvar->type != type)
    {
#ifndef NO_CODE_VARS
        if (type == svt_code)
        {
            /* They want to set a code variable, and a non-code code variable exists */
            /* Delete the old variable */
            if (!sysvar_delete(cs))
            {
                /* Not sure why we would fail to delete, but if we do, we just report bad type */
                return SVE_BADTYPE;
            }
            /* Create the code variable */
            *contextp = NULL;
            return sysvar_create(cs, data, datalen, type, codepw);
        }

        if (sysvar->type == svt_code)
        {
            /* It was a code variable, and now they're setting something else */
            /* Only setting strings are supported */
            if (type != svt_string)
            {
                /* Cannot set a code variable value to anyhting but a string */
                return SVE_BADTYPE;
            }
        }
#endif
    }

    /* The context has been set to the variable name */
    *contextp = sysvar->name;

#ifndef NO_CODE_VARS
    if (sysvar->type == svt_code)
    {
        /* This is a code variable we are setting */
        _kernel_oserror *err;
        err = codevar_write(sysvar->value.data, sysvar->codepw, data, datalen);
        return err ? SVE_FROM_OSERROR(err) : SVE_OK;
    }
    else
#endif
    {
        uint8_t *newdata;
        /* Note: This method means that we won't reallocate memory if the string gets shorter.
         *       However, if you were to allocate really long variable (eg 4000 bytes) then update
         *       as 1 byte long, you would effectively waste the remaining space. This could be
         *       handled better.
         */
        if (sysvar->value.datalen < datalen)
        {
            newdata = malloc(datalen + 1);
            if (newdata == NULL)
                return SVE_NOMEMORY;
            free(sysvar->value.data);
        }
        else
        {
            newdata = sysvar->value.data;
        }

        memcpy(newdata, data, datalen);
        newdata[datalen] = '\0';

        sysvar->value.data = newdata;
        sysvar->value.datalen = datalen;
        sysvar->type = type;
    }
    return SVE_OK;
}


/*************************************************** Gerph *********
 Function:      sysvar_final
 Description:   Finalise the System Variables and release all memory
 Parameters:    none
 Returns:       none
 ******************************************************************/
void sysvar_final(void)
{
    sysvar_t *cur = sysvars;
    sysvars = NULL;
    while (cur)
    {
        sysvar_t *next = cur->next;
        sysvars_free(cur);
        cur = next;
    }
}


#ifdef DEBUG_COMMANDS
/*************************************************** Gerph *********
 Function:      sysvars_dump
 Description:   Produce a list of all the system variables that we know
 Parameters:    none
 Returns:       none
 ******************************************************************/
void sysvars_dump(void)
{
    sysvar_t *cur;
    for (cur=sysvars; cur; cur=cur->next)
    {
        printf("Variable %-20s : type=%-2i, length=%-3i : ",
               cur->name, cur->type, cur->value.datalen);
        if (cur->type == svt_string)
        {
            printf("string : %.*s\n", cur->value.datalen, cur->value.data);
        }
        else if (cur->type == svt_number)
        {
            printf("number : %u\n", *(uint32_t*)cur->value.data);
        }
        else if (cur->type == svt_macro)
        {
            printf("macro : %.*s\n", cur->value.datalen, cur->value.data);
        }
        else
        {
            printf("unknown, data at %p\n", cur->value.data);
        }
    }
}
#endif
