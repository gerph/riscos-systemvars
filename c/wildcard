/*************************************************** Gerph *********
 Function:     wildmatch_sysvars
 Description:  Check whether we match a wildcard (case insensitive,
               for systemvars)
 Parameters:   wild-> the wildcard to match with, terminated by
                      control characters or space
               str-> the string to match, terminated by control
                     chars or space
 Returns:      1 if matched, 0 if no match
 ******************************************************************/
int wildmatch_sysvars(csstring_t wild, csstring_t str)
{
    dprintf("Wild %s against %s\n", wild, str);
    do
    {
        uint32_t w = *wild;
        uint32_t s = *str;

        if (w <= ' ')
            w = '\0';
        if (s <= ' ')
            s = '\0';

        if (s == '\0')
        {
            if (w == '*')
            {
                wild++;
                continue;
            }
            if (w == '\0')
                return 1;       /* Equal */
        }

        if (w == '\0')
            return 0;           /* Not equal */

        /* Make all characters lower case */
        /* Simple case insensitive - won't work for non-ascii, but then classic never did */
        if (w - 'A' <= 'Z' - 'A')
            w += 32;
        if (s - 'A' <= 'Z' - 'A')
            s += 32;

        dprintf("  compare %c against %c\n", w, s);

        if (s != '*')
        {
            if (w == s || w == '?')
            {
                wild++;
                str++;
                continue;
            }
        }
        if (w != '*')
            return 0;           /* Not equal */

        if (wildmatch_sysvars(wild + 1, str))
            return 1;
        return wildmatch_sysvars(wild, str + 1);
    } while (1);
}
