/***************************************************************************
 * Function:     Mod_Init
 * Description:  Initialise the module, setting up vectors, callbacks and
 *               any other parts of the system necessary for the module to
 *               function.
 * Parameters:   tail        = pointer to command line (control terminated)
 *               podule_base = address of podule module was started from, or
 *                             NULL if none
 *               pw          = private word for module
 * On exit:      Return NULL for successful initialisation, or a pointer to
 *               an error block if the module could not start properly.
 **************************************************************************/
_kernel_oserror *Mod_Init(const char *tail, int podule_base, void *pw)
{
    Fortify_EnterScope();
#ifdef OS_SWIS
    register_osswis(pw, true);
#endif
    printf("Module SystemVars initialised\n");
    return NULL;
}


/***************************************************************************
 * Function:     Mod_Final
 * Description:  Finalise the module, shutting down any systems necessary,
 *               freeing vectors and releasing workspace
 * Parameters:   fatal       = fatality indicator; 1 if fatal, 0 if
 *                             reinitialising
 *               podule_base = address of podule module was started from, or
 *                             NULL if none
 *               pw          = private word for module
 * On exit:      Return 0 for successful finalisation, or a pointer to an
 *               error block if module was not shutdown properly.
 **************************************************************************/
_kernel_oserror *Mod_Final(int fatal, int podule_base, void *pw)
{
    printf("Module SystemVars dying\n");
#ifdef OS_SWIS
    register_osswis(pw, false);
#endif
    sysvar_final();
    transform_final();
    Fortify_LeaveScope();
    return NULL;
}

/***************************************************************************
 * Description:  SWI handler routine. All SWIs for this module will be
 *               passed to these routines.
 * Parameters:   number = SWI number within SWI chunk (i.e. 0 to 63)
 *               r      = pointer to register block on entry
 *               pw     = private word for module
 * On exit:      Return NULL if SWI handled sucessfully, setting return
 *               register values (r0-r9) in r.
 *               Return error_BAD_SWI for out of range SWIs.
 *               Return an error block for a custom error.
 **************************************************************************/
/* Functions called to handle particular SWI calls */
_kernel_oserror *SWI_ReadVarVal(int number, _kernel_swi_regs *r, void *pw)
{
    /*
        Read a variable value

        =>  R0 = pointer to variable name, which may be wildcarded (using '*' and '#')
            R1 = pointer to buffer to hold variable value
            R2 = maximum length of buffer, or bit 31 set to check existence/length of variable
            R3 = context pointer (used with wildcarded names), or 0 for first call
            R4 = 3 if an expanded string is to be converted on return

        <=  R0 preserved; or corrupted if R2 bit 31 was set on entry
            R1 preserved
            R2 = number of bytes read
            R3 = new context pointer (null-terminated)
            R4 = variable type
     */
    csstring_t cs = (csstring_t)r->r[0];
    uint8_t *data = (uint8_t*)r->r[1];
    uint32_t datalen = (uint32_t)r->r[2];
    void *context = (void *)r->r[3];
    sysvartype_t type = (sysvartype_t)r->r[4]; /* How to extract */
    sysvar_t *var;
    char numbuffer[10]; /* Length of the longest uint32_t */

    uint8_t *vardata;
    uint32_t vardatalen;
    sysvartype_t vartype;
    const char *varname;

    dprintf("ReadVarVal: %s\n", cs);

    var = sysvar_read(cs, context);
    if (var == NULL)
    {
        r->r[2] = 0;
        dprintf("  not found\n");
        return err_NoSuchVariable;
    }

    varname = var->name;
    vardata = var->value.data;
    vardatalen = var->value.datalen;
    vartype = var->type;

    if (type == svt_expanded || vartype == svt_code)
    {
        /* They want a string form - converted to a value to be read as a string */
        switch (vartype)
        {
            case svt_string:
                break;

            case svt_number:
                {
                    /* We need to convert to a string */
                    vardatalen = sprintf(numbuffer, "%u", *(uint32_t *)vardata);
                    vardata = (uint8_t*)numbuffer;
                }
                break;

            case svt_macro:
                /* Need to expand with GSTrans */
                {
                    _kernel_oserror *err;
                    uint8_t *gsdata;
                    uint32_t gsdatalen;
                    err = transform_gstrans(0, (char *)vardata, (char **)&gsdata, (uint32_t *)&gsdatalen);
                    if (err)
                        return err;
                    vardata = gsdata;
                    vardatalen = gsdatalen;
                }
                break;

            case svt_code:
                {
                    _kernel_oserror *err;
                    err = codevar_read(vardata, var->codepw, &vardata, &vardatalen);
                    if (err)
                        return err;
                }
                break;
        }
        vartype = svt_string;
    }

    if (datalen & (1u<<31))
    {
        /* Check for existence - documented in PRM*/
        r->r[2] = ~vardatalen;
        dprintf("  buffer overflow\n");
        return err_BufferOverflow;
    }

    if (datalen < vardatalen)
    {
        /* Not enough memory for the string */
        r->r[2] = ~vardatalen;
        dprintf("  buffer overflow\n");
        return err_BufferOverflow;
    }

    memcpy(data, vardata, vardatalen);
    r->r[2] = vardatalen;
    r->r[3] = (int)varname;
    r->r[4] = vartype;

    dprintf("  read value '%.*s'\n", vardatalen, vardata);
    return NULL;
}


_kernel_oserror *SWI_SetVarVal(int number, _kernel_swi_regs *r, void *pw)
{
    /*
        Write a variable value

        =>  R0 = pointer to variable name, which may be wildcarded (* and #) if updating/deleting
            R1 = pointer to variable value
            R2 = length of value, or negative to delete the variable
            R3 = context pointer (used with wildcarded names), or 0 for first call
            R4 = variable type
            R5 = code private word (if R4 = 16)

        <=  R0 - R2 preserved
            R3 = new context pointer (null-terminated)
            R4 = variable type created if expression is evaluated
    */
    _kernel_oserror *err;

    csstring_t cs = (csstring_t)r->r[0];
    uint8_t *data = (uint8_t*)r->r[1];
    uint32_t datalen = (uint32_t)r->r[2];
    char *context = (char *)r->r[3];
    sysvartype_t type = (sysvartype_t)r->r[4]; /* How to extract */
    sysvarerror_t sverr;
    uint32_t datanumber;
    void *codepw = (void *)((type == svt_code) ? r->r[5] : NULL);

    dprintf("SetVarVal '%s'\n", cs);

    if (datalen & (1u<<31))
    {
        /* This is a deletion operation */
        /* FIXME: If this is a code variable, we only delete if the type was code - otherwise we set to empty */
        bool deleted;
        dprintf("  is a delete\n");
        deleted = sysvar_delete(cs);
        if (deleted)
            return NULL;
        return err_NoSuchVariable;
    }

    switch (type)
    {
        case svt_string:
            /* svt_string: Should be passed through GSTrans */
            /* svt_macro: Same as literal on store; GSTrans'd on read */
            err = transform_gstrans(0, (char *)data, (char **)&data, (uint32_t *)&datalen);
            if (err)
                return err;
            break;

        case svt_macro:
            /* Macros are only GSTrans'd on read, not on set */
            break;

        case svt_number:
            /* Is a 4 byte value (1 word) */
            /* In 64-bit OS this will remain as 4-bytes, and a new way of setting the value is required */
            /* FIXME: Do we need to check the length */
            break;

        case svt_expanded:
            /* Should be passed through EvaluateExpression */
            {
                bool is_number = true;
                err = transform_evaluate((char *)data, datalen, (char **)&data, (uint32_t *)&datalen, &is_number);
                if (err)
                    return err;
                if (is_number)
                {
                    datanumber = datalen;
                    data = (uint8_t*)&datanumber;
                    datalen = sizeof(number);
                    type = svt_number;
                }
                else
                {
                    type = svt_string;
                }
            }
            break;

        case svt_literal:
            /* Straight through */
            type = svt_string;
            break;

        case svt_code:
            /* No conversion needed here for system variables */
            break;

        /* FIXME: Add svt_number64? */

        default:
            return err_BadType;
    }

    sverr = sysvar_update_or_create(cs, data, datalen, type, codepw, &context);
    dprintf("  Returned with error %i\n", sverr);
    switch (sverr)
    {
        case SVE_OK:
            break;

        case SVE_NOMEMORY:
            return err_NoMemory;

        case SVE_BADNAME:
            return err_BadName;

        case SVE_BADLENGTH:
            return err_BadLength;

        case SVE_BADPOINTER:
            return err_BadPointer;

        case SVE_BADTYPE:
            return err_BadType;

        default:
            if (SVE_IS_OSERROR(sverr))
                return SVE_TO_OSERROR(sverr);
            return err_InternalError;
    }

    r->r[3] = (int)context;
    dprintf("  set ok\n");

    return NULL;
}


